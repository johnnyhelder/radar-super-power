# Copie para <pasta-do-cliente>/.env e preencha. Nunca coloque este arquivo no git.
# O radar só lê o .env da pasta do cliente (não usa variáveis do sistema).

# Firecrawl, plano grátis (1.000 créditos/mês). firecrawl.dev > API Keys
FIRECRAWL_API_KEY=

# Telegram, bot criado no @BotFather. Se o bot já tem outro uso, leia no README a parte "Já tem um bot".
TELEGRAM_BOT_TOKEN=
# Confirme que o bot é só do radar (o "radar escutar" lê as mensagens dele e não corre sem isto).
RADAR_BOT_DEDICADO=
# Deixe vazio na primeira vez, mande "oi" ao bot e corra "radar escutar": ele mostra o seu chat_id.
TELEGRAM_CHAT_ID=

# Resend, plano grátis (3.000 emails/mês, 100/dia). resend.com > API Keys (permissão "Sending access")
RESEND_API_KEY=
# Vazio = modo grátis sem domínio (envia de onboarding@resend.dev).
# Nesse modo o Resend só entrega no email da conta: crie a conta com o email do dono.
RADAR_EMAIL_DE=
RADAR_EMAIL_PARA=
